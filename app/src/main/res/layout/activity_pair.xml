<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E1E1E"
            app:title="Pair Device"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:tabTextColor="#808080"
        app:tabSelectedTextColor="#BB86FC"
        app:tabIndicatorColor="#BB86FC">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Code" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import" />

    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212">

        <LinearLayout
            android:id="@+id/layoutShow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan QR code or share pairing string"
                android:textSize="14sp"
                android:textColor="#808080"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvMyPairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background_dark"
                android:padding="12dp"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:layout_marginBottom="16dp"
                android:maxLines="3"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:backgroundTint="#BB86FC"
                    android:textColor="#000000"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnShareQr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share QR"
                    android:textAllCaps="false"
                    android:backgroundTint="#03DAC5"
                    android:textColor="#000000"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutImport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan QR code or paste pairing string"
                android:textSize="14sp"
                android:textColor="#808080"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan QR Code"
                android:textAllCaps="false"
                android:backgroundTint="#BB86FC"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:textSize="12sp"
                android:textColor="#808080"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pairing Code"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#BB86FC">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPairingInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pair"
                android:textAllCaps="false"
                android:backgroundTint="#03DAC5"
                android:textColor="#000000" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
